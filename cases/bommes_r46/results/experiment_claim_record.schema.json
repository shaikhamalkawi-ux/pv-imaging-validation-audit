{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/99pv/r46/experiment-claim-record.schema.json",
  "title": "99pv experiment-indexed claim-support record (research development schema, version 0.1)",
  "description": "A typed account of the evidence supporting a single reported result; not a formal study-quality score.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "report_doi",
    "source_url",
    "evidence_tier",
    "experiment_id",
    "input_modality",
    "target_task",
    "evaluation_unit",
    "source_version",
    "physical_parent_crosswalk",
    "split_disjointness_unit",
    "target_labels_used_for_selection",
    "metric_name",
    "metric_value",
    "metric_unit",
    "metric_support_n",
    "claim_requested",
    "claim_boundary"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 3
    },
    "report_doi": {
      "type": "string",
      "minLength": 3
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "evidence_tier": {
      "enum": [
        "provider_abstract",
        "publisher_abstract",
        "original_full_methods",
        "owner_code_or_data",
        "raw_parent_manifest_replayed"
      ]
    },
    "experiment_id": {
      "type": "string",
      "minLength": 3
    },
    "input_modality": {
      "enum": [
        "thermal_IR",
        "EL",
        "RGB",
        "radiometric_features",
        "mixed",
        "unknown"
      ]
    },
    "target_task": {
      "type": "string",
      "minLength": 3
    },
    "evaluation_unit": {
      "enum": [
        "image",
        "crop",
        "cell",
        "module",
        "plant",
        "mask",
        "unknown"
      ]
    },
    "source_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "physical_parent_crosswalk": {
      "enum": [
        "unavailable",
        "author_described_only",
        "replayed_from_raw_ids"
      ]
    },
    "split_disjointness_unit": {
      "enum": [
        "image",
        "physical_image_parent",
        "cell",
        "module",
        "plant",
        "unknown"
      ]
    },
    "target_labels_used_for_selection": {
      "enum": [
        "yes",
        "no_author_reported",
        "no_replayed",
        "unknown"
      ]
    },
    "metric_name": {
      "type": "string",
      "minLength": 3
    },
    "metric_value": {
      "type": [
        "number",
        "null"
      ]
    },
    "metric_unit": {
      "enum": [
        "AUROC_percent",
        "AUROC_fraction",
        "accuracy_percent",
        "F1_percent",
        "mAP_fraction",
        "other",
        "not_reported"
      ]
    },
    "metric_support_n": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "claim_requested": {
      "enum": [
        "source_reported_score",
        "author_reported_grouped_split",
        "author_reported_crossplant_experiment",
        "untouched_target_model_selection",
        "replayed_physical_parent_disjointness"
      ]
    },
    "claim_boundary": {
      "type": "string",
      "minLength": 12
    },
    "raw_manifest_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "zero_overlap_parents_replayed": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "source_locators": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
